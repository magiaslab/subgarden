# Next.js Environment Variables
NEXT_PUBLIC_SITE_URL=https://subgarden.it

# SEO & Analytics (caricati solo dopo consenso cookie)
# Google Analytics 4: crea proprietà su analytics.google.com → Measurement ID (G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Tag Manager (opzionale, alternativo a GA diretto): container ID GTM-XXXXXXX
# NEXT_PUBLIC_GTM_ID=

# Search Console: nessuna key; verifica sito con meta tag o DNS e invia sitemap https://subgarden.it/sitemap.xml

# Vercel Blob (read-write token for uploads)
# SUB_READ_WRITE_TOKEN=

# Hero background video (optional). Use a direct MP4 URL from Vercel Blob, Cloudflare R2, Bunny, etc. Leave empty to use local /hero-bg.mp4
# NEXT_PUBLIC_HERO_VIDEO_URL=

# Explanatory video on home (optional). Direct MP4 URL; section is hidden if empty.
# Usa l'URL pubblico del file (es. Vercel Blob: https://xxx.public.blob.vercel-storage.com/nome.mp4).
# Dopo averla aggiunta in Vercel → Settings → Environment Variables, esegui un nuovo Deploy.
# NEXT_PUBLIC_EXPLANATORY_VIDEO_URL=

# Video pagina Tecnologia (opzionale). Se vuoto, in tecnologia si usa EXPLANATORY_VIDEO_URL.
# Per Vercel Blob: carica il file, poi copia l'URL pubblico nel valore della variabile.
# NEXT_PUBLIC_TECHNOLOGY_VIDEO_URL=
# NEXT_PUBLIC_TECHNOLOGY_VIDEO_POSTER_URL=

# Video below infographics on home (optional). Use Vercel Blob or other direct MP4 URL.
# NEXT_PUBLIC_HOME_VIDEO_URL=
# NEXT_PUBLIC_HOME_VIDEO_POSTER_URL=

# CMS Configuration (for future integration)
# SANITY_PROJECT_ID=
# SANITY_DATASET=
# CONTENTFUL_SPACE_ID=
# CONTENTFUL_ACCESS_TOKEN=

# Form contatti: Resend (resend.com). Con RESEND_API_KEY + CONTACT_EMAIL_TO le email partono davvero.
# RESEND_API_KEY=
# Email che riceve i messaggi dal form (obbligatoria per invio reale)
# CONTACT_EMAIL_TO=
# Mittente (dominio verificato su Resend in prod; per test: onboarding@resend.dev)
# RESEND_FROM_EMAIL=onboarding@resend.dev
